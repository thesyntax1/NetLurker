<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is refused everywhere except the one endpoint that has no HTTPS on its free
  tier. ip-api.com is the geolocation provider the desktop build already uses; the only
  data it receives is the list of addresses being looked up.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
</network-security-config>
